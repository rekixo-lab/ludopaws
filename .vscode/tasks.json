{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "⚡ Fast Run LudoProof",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/run-ludoproof.sh"
      ],
      "windows": {
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/run-ludoproof.ps1"]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
