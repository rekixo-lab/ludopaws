{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ludo Paws: Build, install and open",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/android-local-testing.mjs",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
