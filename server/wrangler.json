{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ludoproof-game-api",
  "main": "src/index-account.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.ludopaws.rekixo.com/*",
      "zone_name": "rekixo.com"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LUDOPROOF_MATCHES",
        "class_name": "MatchRoom"
      },
      {
        "name": "LUDOPROOF_API_GATE",
        "class_name": "ApiGate"
      },
      {
        "name": "LUDOPROOF_LEADERBOARD",
        "class_name": "LeaderboardRoom"
      },
      {
        "name": "LUDOPROOF_MATCHMAKER",
        "class_name": "MatchmakerQueue"
      },
      {
        "name": "LUDOPROOF_FRIENDS",
        "class_name": "FriendDirectory"
      },
      {
        "name": "LUDOPROOF_TEAM_MATCHMAKER",
        "class_name": "TeamMatchmakerQueue"
      },
      {
        "name": "LUDOPROOF_FRIEND_CONVERSATIONS",
        "class_name": "FriendConversation"
      },
      {
        "name": "LUDOPROOF_FRIEND_RECENT",
        "class_name": "FriendRecentRoom"
      },
      {
        "name": "LUDOPROOF_STORE_PURCHASES",
        "class_name": "StorePurchaseLedger"
      },
      {
        "name": "LUDOPROOF_ACCOUNT_DIRECTORY",
        "class_name": "AccountDirectory"
      },
      {
        "name": "LUDOPROOF_PLAYER_ACCOUNTS",
        "class_name": "PlayerAccount"
      },
      {
        "name": "LUDOPROOF_STORE_CATALOG",
        "class_name": "StoreCatalogStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MatchRoom"
      ]
    },
    {
      "tag": "v2-rate-gate",
      "new_sqlite_classes": [
        "ApiGate"
      ]
    },
    {
      "tag": "v3-leaderboard",
      "new_sqlite_classes": [
        "LeaderboardRoom"
      ]
    },
    {
      "tag": "v4-matchmaker",
      "new_sqlite_classes": [
        "MatchmakerQueue"
      ]
    },
    {
      "tag": "v5-friends",
      "new_sqlite_classes": [
        "FriendDirectory"
      ]
    },
    {
      "tag": "v6-match-receipts",
      "new_sqlite_classes": [
        "MatchReceiptArchive"
      ]
    },
    {
      "tag": "v7-team-matchmaker",
      "new_sqlite_classes": [
        "TeamMatchmakerQueue"
      ]
    },
    {
      "tag": "v8-friend-social",
      "new_sqlite_classes": [
        "FriendConversation",
        "FriendRecentRoom"
      ]
    },
    {
      "tag": "v9-store-purchases",
      "new_sqlite_classes": [
        "StorePurchaseLedger"
      ]
    },
    {
      "tag": "v10-account-directory",
      "new_sqlite_classes": [
        "AccountDirectory"
      ]
    },
    {
      "tag": "v11-player-accounts",
      "new_sqlite_classes": [
        "PlayerAccount"
      ]
    },
    {
      "tag": "v12-store-catalog",
      "new_sqlite_classes": [
        "StoreCatalogStore"
      ]
    },
    {
      "tag": "v13-remove-online-receipts",
      "deleted_classes": [
        "MatchReceiptArchive"
      ]
    }
  ],
  "vars": {
    "LUDOPROOF_AGE_SAFETY_MODE": "FAMILY_V1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
