@tool
extends RefCounted
## Elephant anatomy and materials. Port of ElephantGeometry.kt and the colours in ElephantRenderer.kt.

const G = preload("res://scripts/game/board3d/paw_geometry.gd")

const SKIN := Color(0.53, 0.61, 0.68, 1)
const INNER_EAR := Color(0.73, 0.54, 0.57, 1)
