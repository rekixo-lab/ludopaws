## Goat anatomy and materials. Port of GoatGeometry.kt and GoatMaterials.kt.
## Rings: [y, radiusX, radiusZ, centerX, centerZ, roundness].

const G = preload("res://scripts/game/board3d/paw_geometry.gd")

const IVORY := Color(0.91, 0.87, 0.75, 1)
const CREAM := Color(0.82, 0.735, 0.58, 1)
const MUZZLE := Color(0.77, 0.70, 0.59, 1)
const EAR_TAN := Color(0.63, 0.51, 0.36, 1)
const EAR_INNER := Color(0.65, 0.43, 0.35, 1)
const FUR_LIGHT := Color(1.00, 0.98, 0.91, 1)
const FUR_SHADE := Color(0.61, 0.53, 0.40, 1)
const BEARD := Color(0.74, 0.66, 0.52, 1)
const HORN := Color(0.60, 0.46, 0.29, 1)
const HOOF_DARK := Color(0.14, 0.13, 0.12, 1)
const EYE_GOLD := Color(0.82, 0.57, 0.18, 1)
const HOOF_WARM := Color(0.20, 0.17, 0.13, 1)
const NOSE_TAUPE := Color(0.29, 0.24, 0.19, 1)
const EYE_RIM := Color(0.24, 0.19, 0.14, 1)
const LIP := Color(0.20, 0.16, 0.13, 1)
const TONGUE := Color(0.61, 0.33, 0.29, 1)

static var _cache := {}

static func mesh(name: String) -> G.Geo:
	if _cache.is_empty():
		_build()
	return _cache[name]

static func _build() -> void:
	_cache["body"] = G.loft([[-0.27, 0.12, 0.17, 0, -0.05], [-0.19, 0.29, 0.33, 0, -0.05],
		[-0.02, 0.40, 0.50, 0, -0.09], [0.19, 0.425, 0.54, 0, -0.125], [0.36, 0.36, 0.39, 0, -0.13],
		[0.46, 0.23, 0.23, 0, -0.07], [0.50, 0.06, 0.08, 0, -0.04]], 24, 3)
	_cache["neck"] = G.loft([[0.31, 0.23, 0.25, 0, 0.04], [0.48, 0.25, 0.25, 0, 0.055],
		[0.66, 0.23, 0.22, 0, 0.06], [0.81, 0.19, 0.19, 0, 0.025], [0.90, 0.10, 0.13]], 20, 3)
	_cache["head"] = G.loft([[0.60, 0.07, 0.10, 0, 0.20], [0.69, 0.15, 0.16, 0, 0.18],
		[0.82, 0.23, 0.25, 0, 0.10], [1.01, 0.32, 0.265, 0, -0.015], [1.18, 0.29, 0.23, 0, -0.045],
		[1.30, 0.18, 0.16, 0, -0.06], [1.34, 0.04, 0.045, 0, -0.06]], 28, 3)
	_cache["muzzle"] = G.loft([[-0.12, 0.10, 0.095], [-0.07, 0.185, 0.16, 0, 0.035],
		[0.04, 0.19, 0.17], [0.12, 0.12, 0.10, 0, -0.035]], 20)
	_cache["jaw"] = G.loft([[-0.065, 0.08, 0.10], [-0.025, 0.15, 0.15], [0.045, 0.16, 0.15], [0.08, 0.09, 0.09]], 18)
	_cache["ear"] = G.loft([[0.0, 0.045, 0.035], [0.11, 0.11, 0.038, 0, 0.025], [0.26, 0.14, 0.03, 0, 0.045],
		[0.40, 0.095, 0.022, 0, 0.04], [0.51, 0.008, 0.006, 0.035, -0.015]], 16)
	var horn: Array = []
	for step in 23:
		var t := step / 22.0
		var radius := 0.077 * pow(1.0 - t, 0.8) + 0.003
		var ridge := 1.0 + 0.08 * (1.0 - t) * cos(t * PI * 22.0)
		horn.append([t * 0.465, radius * ridge, radius * ridge * 0.90, 0.032 * t + 0.079 * t * t, -0.31 * t * t])
	_cache["horn"] = G.loft(horn, 14)
	_cache["shin"] = G.loft([[-0.5, 0.64, 0.70], [-0.38, 0.81, 0.82], [0.18, 0.72, 0.80], [0.43, 0.97, 1.0], [0.5, 0.68, 0.75]], 14)
	_cache["thigh"] = G.loft([[-0.5, 0.56, 0.60], [-0.30, 0.90, 0.89], [0.12, 1.0, 1.0], [0.38, 0.81, 0.88], [0.5, 0.50, 0.50]], 16)
	_cache["hoof"] = G.loft([[-0.09, 0.047, 0.11, 0, 0, 0.36], [-0.05, 0.052, 0.12, 0, 0.015, 0.36],
		[0.05, 0.045, 0.09, 0, 0, 0.50], [0.09, 0.025, 0.052, 0, -0.015]], 16)
	_cache["beard"] = G.loft([[-0.27, 0.004, 0.004, 0, 0.049], [-0.21, 0.023, 0.018, 0, 0.037],
		[-0.16, 0.045, 0.029, 0, 0.015], [-0.05, 0.075, 0.040], [0.0, 0.055, 0.035]], 14)
	_cache["tuft"] = G.loft([[-0.09, 0.004, 0.004], [-0.035, 0.045, 0.012], [0.02, 0.03, 0.013]], 10)
	_cache["tail"] = G.loft([[0.0, 0.075, 0.075], [0.10, 0.075, 0.065, 0, -0.03], [0.22, 0.065, 0.05, 0, -0.055], [0.30, 0.008, 0.01, 0, -0.07]], 14)
